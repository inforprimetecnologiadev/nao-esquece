<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Hoje" do Não Esquece -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoje"
                android:textColor="#E4EAF5"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#93A0B8"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/w_new"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="+ Nova nota"
            android:textColor="#041330"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">
    <LinearLayout
        android:id="@+id/w_r1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/w_t1"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:textColor="#4AB6FF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_n1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E4EAF5"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_r2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/w_t2"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:textColor="#4AB6FF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_n2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E4EAF5"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_r3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/w_t3"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:textColor="#4AB6FF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_n3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E4EAF5"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_r4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/w_t4"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:textColor="#4AB6FF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_n4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E4EAF5"
            android:textSize="14sp" />
    </LinearLayout>

        <TextView
            android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="Nenhum lembrete para hoje"
            android:textColor="#93A0B8"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/w_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textColor="#93A0B8"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
